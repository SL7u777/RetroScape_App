# Proveedor de IA: gemini, groq o simulado (solo pruebas).
# Si se deja vacío, se usa Gemini o Groq según la clave que exista.
IA_PROVEEDOR=gemini

GEMINI_API_KEY=tu_clave_de_google_ai_studio
GEMINI_MODEL=gemini-3.8-flash

GROQ_API_KEY=tu_clave_de_groq
GROQ_MODEL=openai/gpt-oss-120b
# Con la clave de Groq también se transcribe la voz en los navegadores sin dictado propio
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

PORT=5173
